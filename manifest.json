{
  "schemaVersion": 1,
  "id": "github.feed",
  "name": "GitHub Feed",
  "version": "0.2.0",
  "author": "Christos Koumpis",
  "description": "Native GitHub activity feed for the Omarchy bar, with local caching",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "GitHub Feed",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "limit": 10, "repo": "", "username": "" }
  }
}
